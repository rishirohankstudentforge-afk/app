generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exam {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(250)
  date                String         @db.VarChar(100)
  time                String         @db.VarChar(100)
  description         String?
  totalQns            Int            @map("total_qns")
  typesOfQns          String         @map("types_of_qns") @db.VarChar(250)
  companyName         String         @map("company_name") @db.VarChar(250)
  custom_fields       Json?          @default("{}")
  companyLogo         String?        @map("company_logo")
  isStarted           Boolean?       @default(false) @map("is_started")
  showLogin           Boolean?       @default(false) @map("show_login")
  registration_closed Boolean?       @default(false)
  submit_code         String?        @db.VarChar(6)
  registrations       Registration[]

  @@map("exams")
}

model Registration {
  id                 Int       @id @default(autoincrement())
  examId             Int       @map("exam_id")
  candidateName      String    @map("candidate_name") @db.VarChar(150)
  email              String    @db.VarChar(150)
  phone              String    @db.VarChar(50)
  college            String    @db.VarChar(200)
  department         String    @db.VarChar(100)
  yearOfStudy        String    @map("year_of_study") @db.VarChar(50)
  photoUrl           String    @map("photo_url")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  registrationNumber String?   @map("registration_number") @db.VarChar(10)
  hallTicketNumber   String?   @map("hall_ticket_number") @db.VarChar(15)
  answers            Json?     @default("{}")
  blocked            Boolean?  @default(false)
  exam               Exam      @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("registrations")
}

model Session {
  id             String  @id @db.VarChar(50)
  student        String  @db.VarChar(100)
  email          String  @db.VarChar(100)
  exam           String  @db.VarChar(200)
  flagsCount     Int?    @default(0) @map("flags_count")
  integrityScore Int?    @default(100) @map("integrity_score")
  lastFlagType   String? @default("None") @map("last_flag_type") @db.VarChar(100)
  severity       String? @default("Normal") @db.VarChar(50)
  timestamp      String  @db.VarChar(50)
  avatar         String  @db.VarChar(10)
  liveFeed       String? @map("live_feed")
  visitor_id     String?

  @@map("sessions")
}

model candidates {
  id         Int       @id @default(autoincrement())
  full_name  String    @db.VarChar(150)
  email      String    @unique @db.VarChar(150)
  password   String    @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  college    String?   @db.VarChar(200)
  department String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model security_logs {
  id         BigInt   @id @default(autoincrement())
  session_id String
  visitor_id String?
  event_type String
  details    String?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_security_logs_created_at")
  @@index([session_id], map: "idx_security_logs_session_id")
  @@index([visitor_id], map: "idx_security_logs_visitor_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_registrations {
  id           Int       @id @default(autoincrement())
  full_name    String    @db.VarChar(200)
  email        String    @db.VarChar(200)
  phone        String    @db.VarChar(50)
  address      String
  dob          String    @db.VarChar(50)
  college_name String    @db.VarChar(200)
  branch       String    @db.VarChar(200)
  interests    String    @db.VarChar(200)
  photo_url    String
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model Hackathon {
  id              String   @id @default(cuid())
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  teamSize        Int
  type            String   @default("Online")
  phases          String?  @db.Text
  image           String?  @db.Text
  prizeFirst      String?
  prizeSecond     String?
  prizeThird      String?
  perks           String?  @db.Text
  registrationFee Float    @default(0)
  hasFee          Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Sprint Additions
  joinCode          String?     @unique
  questions         String?     @db.Text // JSON stringified questions list
  logoUrl           String?     @db.Text
  location          String?
  isStarted         Boolean     @default(false)
  isPaused          Boolean     @default(false)
  pausedAt          DateTime?
  parentHackathonId String?     // If this is a Sprint inside a Hackathon
  parentHackathon   Hackathon?  @relation("HackathonSprints", fields: [parentHackathonId], references: [id])
  sprints           Hackathon[] @relation("HackathonSprints")
}

model SprintParticipant {
  id             String   @id @default(cuid())
  sprintId       String
  name           String
  email          String
  joinedAt       DateTime @default(now())
  score          Int      @default(0)
  answers        String?  @db.Text // Saved candidate answers (JSON)
  warningsCount  Int      @default(0)
  isLocked       Boolean  @default(false)
  isSubmitted    Boolean  @default(false)
  deviceId       String?
  latestSnapshot String?  @db.Text
  cheatingLogs   String?  @db.Text // JSON array of violation events
}

model SprintSubmission {
  id          String   @id @default(cuid())
  sprintId    String
  email       String
  score       Int      @default(0)
  answers     String   @db.Text // JSON stringified candidate submissions
  submittedAt DateTime @default(now())
}

model CandidateNotification {
  id        String   @id @default(cuid())
  email     String   // Target candidate email
  sender    String   // Sender name (e.g. System Administrator)
  subject   String
  body      String   @db.Text
  date      DateTime @default(now())
  unread    Boolean  @default(true)
}

model CandidateOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Team {
  id          String   @id @default(cuid())
  name        String
  hackathonId String
  members     String   @db.Text @default("[]") // JSON array of candidate emails
  createdAt   DateTime @default(now())
}

model Submission {
  id          String   @id @default(cuid())
  githubUrl   String?
  demoUrl     String?
  teamId      String
  createdAt   DateTime @default(now())
}

model SystemSettings {
  id                        Int      @id @default(1)
  ai_audio_detection        Boolean  @default(true)
  webcam_face_recognition   Boolean  @default(true)
  tab_switch_lockout        Boolean  @default(true)
  fullscreen_enforcement    Boolean  @default(true)
  auto_incident_logging     Boolean  @default(true)
  email_proctor_alerts      Boolean  @default(false)
  public_registration_open  Boolean  @default(true)
  auto_release_results      Boolean  @default(false)
  updated_at                DateTime @default(now()) @updatedAt

  @@map("system_settings")
}

model Organizer {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  password     String
  organization String?
  createdAt    DateTime  @default(now())
}

// Candidate social: friend connections
model CandidateConnection {
  id                 String   @id @default(cuid())
  from_email         String
  from_name          String
  to_registration_id Int      // registrations.id of the target
  to_email           String   @default("") // filled on acceptance
  to_name            String   @default("")
  status             String   @default("pending") // pending | accepted | rejected
  created_at         DateTime @default(now())

  @@unique([from_email, to_registration_id])
}

// Candidate social: chat messages within an accepted connection
model CandidateChatMessage {
  id            String   @id @default(cuid())
  connection_id String
  sender_email  String
  sender_name   String
  message       String   @db.Text
  created_at    DateTime @default(now())
}
